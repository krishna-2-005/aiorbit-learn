# Copy to .env and fill in real values. Never commit .env.

# Postgres. Local: `docker compose up -d` and use the values below.
# Neon: DATABASE_URL is the pooled (-pooler) string, DIRECT_URL the direct one (used by migrations).
DATABASE_URL="postgresql://aiorbit:aiorbit@localhost:5434/aiorbit"
DIRECT_URL="postgresql://aiorbit:aiorbit@localhost:5434/aiorbit"

# Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Public base URL, used for metadata and absolute links. Optional on Vercel, which
# provides VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local only: set to 1 if images fail with "unable to verify the first certificate"
# (an HTTPS-inspecting proxy that Node doesn't trust). Never set in production.
# NEXT_IMAGE_UNOPTIMIZED=1
